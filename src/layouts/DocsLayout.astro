---
import { getCollection } from "astro:content";
import Header from "../components/Header.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import DocCallout from "../components/DocCallout.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/docs.css";

const {
  title,
  description,
  section,
  docId = "",
  showAlpha = true,
} = Astro.props;
const pageTitle = title.includes("Elpod") ? title : `${title} | Elpod`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageType = docId === "index" ? "CollectionPage" : docId === "faq" || docId === "glossary" ? "WebPage" : "TechArticle";
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Elpod", item: "https://elpod.vercel.app/" },
  { "@type": "ListItem", position: 2, name: "Documentation", item: "https://elpod.vercel.app/docs/" },
  ...(docId === "index" ? [] : [{ "@type": "ListItem", position: 3, name: title, item: canonical.href }]),
];
const structuredData = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: breadcrumbItems },
  { "@context": "https://schema.org", "@type": pageType, headline: title, description, url: canonical.href, isPartOf: { "@id": "https://elpod.vercel.app/#website" }, about: [{ "@type": "SoftwareApplication", name: "Elpod", url: "https://elpod.vercel.app/" }, { "@type": "SoftwareApplication", name: "Elysia" }, { "@type": "SoftwareApplication", name: "Bun" }] },
];
const entries = await getCollection("docs");
const sectionOrder = { foundations: 1, runtime: 2, security: 3, operations: 4 } as const;
const orderedEntries = entries
  .filter((entry) => entry.id !== "index")
  .sort((a, b) => sectionOrder[a.data.section] - sectionOrder[b.data.section] || a.data.order - b.data.order);
const currentIndex = orderedEntries.findIndex((entry) => entry.id === docId);
const previous = currentIndex > 0 ? orderedEntries[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < orderedEntries.length - 1 ? orderedEntries[currentIndex + 1] : null;
const hrefFor = (id: string) => `/docs/${id}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d12" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/elpod-og.png", Astro.site)} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/elpod-og.png", Astro.site)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/elpod-mark.png" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class:list={['docs-body', { 'docs-home-body': docId === 'index' }]}>
    <a class="skip-link" href="#doc-content">Skip to documentation</a>
    <Header />
    <div class="docs-shell">
      <DocsSidebar pathname={Astro.url.pathname} />
      <main class="docs-main" id="doc-content">
        <div class="docs-route-meta">
          <span>ELPOD / DOCS</span>
          <span>{section.toUpperCase()}</span>
        </div>
        <article class="doc-prose">
          <div class:list={['docs-home-hero', { 'docs-home-hero-active': docId === 'index' }]}>
            <div>
              <p class="section-kicker">{section} / reference</p>
              <h1>{title}</h1>
              <p class="doc-description">{description}</p>
            </div>
            {docId === 'index' && (
              <aside class="docs-home-map" aria-label="Elpod composition map">
                <div class="docs-home-map-label"><span>COMPOSITION MAP</span><span>01 / 03</span></div>
                <ol>
                  <li><span><b>Elysia</b><small>native route surface</small></span></li>
                  <li><span><b>Elpod</b><small>explicit composition</small></span></li>
                  <li><span><b>Your application</b><small>features + boundaries</small></span></li>
                </ol>
              </aside>
            )}
          </div>
          <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Elpod</a><span aria-hidden="true">/</span>
            {docId === "index" ? <span aria-current="page">Documentation</span> : <><a href="/docs/">Documentation</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></>}
          </nav>
          {showAlpha && (
            <DocCallout>
              Elpod is early-stage. Pin Elpod and Bun versions, read the changelog before upgrades, and run <code>elpod audit</code> and <code>elpod doctor</code> in CI.
            </DocCallout>
          )}
          <slot />
        </article>
        {docId !== 'index' && (
          <nav class="docs-pager" aria-label="Documentation navigation">
            {previous ? (
              <a href={hrefFor(previous.id)}>
                <span class="docs-next-label">← Previous</span>
                <strong>{previous.data.label}</strong>
              </a>
            ) : <a aria-disabled="true" href="#" tabindex="-1"><span></span></a>}
            {next ? (
              <a href={hrefFor(next.id)}>
                <span class="docs-next-label">Next →</span>
                <strong>{next.data.label}</strong>
              </a>
            ) : <a aria-disabled="true" href="#" tabindex="-1"><span></span></a>}
          </nav>
        )}
        <footer class="docs-footer">
          <span>ELPOD / WORKING ALPHA</span>
          <a href="https://github.com/elpodjs/core" target="_blank" rel="noreferrer">Source on GitHub ↗</a>
        </footer>
      </main>
    </div>
  </body>
</html>
